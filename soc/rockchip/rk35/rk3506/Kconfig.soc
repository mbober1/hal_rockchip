config SOC_RK3506
	bool
	select SOC_SERIES_RK35
	select ARM
	select CPU_CORTEX_M0
	select CPU_CORTEX_M_HAS_SYSTICK
	select SOC_EARLY_INIT_HOOK
	help
	  Enable support for the Rockchip RK3506 MCU

config SOC
	default "rk3506" if SOC_RK3506
